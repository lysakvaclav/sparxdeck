# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of this app (used in e-mails, QR codes and auth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Landing page (links to the privacy policy and terms). Default https://sparxdeck.com.
NEXT_PUBLIC_MARKETING_URL=

# Supabase project (Project Settings -> API). Region: Central EU (Frankfurt).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (the "secret" key, formerly service_role). Bypasses Row Level Security: never expose to the browser.
SUPABASE_SECRET_KEY=

# Migrations: Supabase dashboard -> Connect -> "Session pooler" connection string (with the database password filled in).
# Used by `supabase db push --db-url`, so no CLI login is needed.
SUPABASE_DB_URL=

# Resend (transactional e-mail). Optional in development: without it, invite links are shown in the UI.
RESEND_API_KEY=
EMAIL_FROM="SparxDeck <noreply@sparxdeck.com>"

# Scheduled jobs (weekly summary): a long random string. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>"; without it the job endpoint answers 404.
CRON_SECRET=

# Sentry (error tracking). Optional: without the DSN nothing is sent. Choose the EU
# region when creating the project. The other three upload source maps at build time.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Map of buildings (part 21). Folder of our own base map: world.pmtiles,
# detail.pmtiles, fonts/ and sprites/ (docs/DEPLOY.md, part 10). Locally
# /vendor/map (files in public/vendor/map), in production the public "map"
# bucket of Supabase Storage. Empty: the outline of Czechia and a grid.
NEXT_PUBLIC_MAP_BASE_URL=
